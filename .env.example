# --- Supabase (Project Settings -> API) ---
# Public values: safe to expose to the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- AI provider (server only, never prefix with NEXT_PUBLIC_) ---
# anthropic (default, most accurate) or gemini (has a free tier)
AI_PROVIDER=anthropic

# Claude: https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=claude-opus-5-5

# Gemini: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Used when the main model is overloaded, out of quota or too slow:
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
